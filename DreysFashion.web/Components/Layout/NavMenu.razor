@rendermode InteractiveServer

@using DreysFashion.web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject ICartService CartService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<nav class="navbar navbar-expand-lg site-navbar">
    <div class="container-fluid">

        <!-- Brand -->
        <a class="navbar-brand fw-bold" href="/">
            <i class="fas fa-shirt me-2"></i>DreysFashion
        </a>

        <!-- Toggler Button for Mobile -->
        <button class="navbar-toggler" type="button" @onclick="ToggleNavbar" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Items -->
        <div class="@("collapse navbar-collapse " + (navbarOpen ? "show" : ""))">
            <ul class="navbar-nav ms-auto">

                <!-- Admin Dashboard (Only for Admins) -->
                @if (isAdmin)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link text-white" href="/admin">
                            <i class="fas fa-tachometer-alt me-1"></i>
                            Dashboard
                        </NavLink>
                    </li>
                }

                <!-- Home -->
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="/" Match="NavLinkMatch.All">
                        <i class="fas fa-home me-1"></i>
                        Home
                    </NavLink>
                </li>

                <!-- Shop -->
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="/shop">
                        <i class="fas fa-store me-1"></i>
                        Shop
                    </NavLink>
                </li>

                <!-- My Orders -->
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="/my-orders">
                        <i class="fas fa-box me-1"></i>
                        My Orders
                    </NavLink>
                </li>

                <!-- Custom Tailoring Dropdown -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle text-white" href="#" role="button" @onclick="ToggleTailoringDropdown" @onclick:preventDefault>
                        <i class="fas fa-scissors me-1"></i>
                        Custom Tailoring
                    </a>
                    @if (tailoringDropdownOpen)
                    {
                        <ul class="dropdown-menu dropdown-menu-end show">
                            <li>
                                <NavLink class="dropdown-item" href="/my-measurements">
                                    <i class="bi bi-rulers me-1"></i>
                                    My Measurements
                                </NavLink>
                            </li>
                            <li>
                                <NavLink class="dropdown-item" href="/my-tailoring-requests">
                                    <i class="bi bi-list-check me-1"></i>
                                    My Tailoring Requests
                                </NavLink>
                            </li>
                        </ul>
                    }
                </li>

                <!-- My Account -->
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="/account">
                        <i class="fas fa-user me-1"></i>
                        My Account
                    </NavLink>
                </li>

                <!-- About -->
                <li class="nav-item">
                    <NavLink class="nav-link text-white" href="/about">
                        <i class="fas fa-info-circle me-1"></i>
                        About
                    </NavLink>
                </li>

                <!-- Cart with Badge -->
                <li class="nav-item ms-3">
                    <a class="nav-link position-relative text-white" href="/cart">
                        <i class="fas fa-shopping-cart"></i>
                        @if (cartItemCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @cartItemCount
                            </span>
                        }
                    </a>
                </li>
            </ul>

            <!-- Search Bar -->
            <div class="ms-3 search-container">
                <input type="text" 
                       class="form-control form-control-sm search-navbar" 
                       placeholder="Search products..." 
                       @bind="searchQuery"
                       @onkeyup="HandleSearch" />
            </div>
        </div>
    </div>
</nav>


@code {
    private int cartItemCount;
    private bool isAdmin;
    private bool navbarOpen;
    private bool tailoringDropdownOpen;
    private string searchQuery = "";

    private void ToggleNavbar()
    {
        navbarOpen = !navbarOpen;
    }

    private void ToggleTailoringDropdown()
    {
        tailoringDropdownOpen = !tailoringDropdownOpen;
    }

    private void HandleSearch(KeyboardEventArgs e)
    {
        // Null check for keyboard event args
        if (e == null)
            return;

        // Trigger search on Enter key
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery) && NavigationManager != null)
        {
            try
            {
                // Navigate to shop page with search query
                NavigationManager.NavigateTo("/shop");
                searchQuery = "";
            }
            catch
            {
                // Handle any navigation errors silently
                searchQuery = "";
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        cartItemCount = CartService.GetItemCount();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");

        CartService.CartChanged += OnCartChanged;
    }

    private void OnCartChanged()
    {
        cartItemCount = CartService.GetItemCount();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartService.CartChanged -= OnCartChanged;
    }
}
}