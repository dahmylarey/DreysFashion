@rendermode InteractiveServer

@using DreysFashion.web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject ICartService CartService
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">

        <a class="navbar-brand" href="">
            DreysFashion
        </a>

    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <!-- Home -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/"
                     Match="NavLinkMatch.All">

                <i class="fas fa-home me-2" aria-hidden="true"></i>
                Home

            </NavLink>

        </div>


        <!-- Shop -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/shop">

                <i class="fas fa-store me-2" aria-hidden="true"></i>
                Shop

            </NavLink>

        </div>


        <!-- Cart -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/cart">

                <i class="fas fa-shopping-cart me-2" aria-hidden="true"></i>
                Cart

                @if (cartItemCount > 0)
                {
                    <span class="cart-count">
                        @cartItemCount
                    </span>
                }

            </NavLink>

        </div>


        <!-- My Orders -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/my-orders">

                <i class="fas fa-box me-2" aria-hidden="true"></i>
                My Orders

            </NavLink>

        </div>


        <!-- Custom Tailoring -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/custom-tailoring">

                <i class="fas fa-scissors me-2" aria-hidden="true"></i>
                Custom Tailoring

            </NavLink>

        </div>


        <!-- My Measurements -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/my-measurements">

                <i class="bi bi-rulers me-2"></i>
                My Measurements

            </NavLink>

        </div>


        <!-- My Tailoring Requests -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/my-tailoring-requests">

                <i class="bi bi-list-check me-2"></i>
                My Tailoring Requests

            </NavLink>

        </div>


        <!-- About -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/about">

                <i class="fas fa-info-circle me-2" aria-hidden="true"></i>
                About

            </NavLink>

        </div>


        <!-- My Account -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/account">

                <i class="fas fa-user me-2" aria-hidden="true"></i>
                My Account

            </NavLink>

        </div>


        <!-- ===================================================== -->
        <!-- ADMIN DASHBOARD -->
        <!-- Only visible to Admin users -->
        <!-- ===================================================== -->
        @if (isAdmin)
        {
            <div class="nav-item px-3">

                <NavLink class="nav-link"
                         href="/admin">

                    <i class="fas fa-tachometer-alt me-2"
                       aria-hidden="true"></i>

                    Dashboard

                </NavLink>

            </div>
        }

    </nav>

</div>


@code {

    /// <summary>
    /// Stores the current number of products in the shopping cart.
    /// </summary>
    private int cartItemCount;


    /// <summary>
    /// Indicates whether the currently authenticated user
    /// belongs to the Admin role.
    /// </summary>
    private bool isAdmin;


    /// <summary>
    /// Initializes the navigation menu, loads the current
    /// user's role and subscribes to cart changes.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // Get current cart count.
        cartItemCount = CartService.GetItemCount();

        // Get current authentication state.
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user = authState.User;

        // Check whether the current user is an Admin.
        isAdmin = user.IsInRole("Admin");

        // Subscribe to cart changes.
        CartService.CartChanged += OnCartChanged;
    }


    /// <summary>
    /// Updates the cart count when the shopping cart changes.
    /// </summary>
    private void OnCartChanged()
    {
        cartItemCount = CartService.GetItemCount();

        InvokeAsync(StateHasChanged);
    }


    /// <summary>
    /// Unsubscribes from the cart service when the
    /// navigation menu is disposed.
    /// </summary>
    public void Dispose()
    {
        CartService.CartChanged -= OnCartChanged;
    }
}