@rendermode InteractiveServer

@using DreysFashion.web.Services.Interfaces

@inject ICartService CartService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">

        <a class="navbar-brand" href="">
            DreysFashion
        </a>

    </div>
</div>

<input type="checkbox"
       title="Navigation menu"
       class="navbar-toggler" />

<div class="nav-scrollable"
     onclick="document.querySelector('.navbar-toggler').click()">

    <nav class="nav flex-column">

        <!-- Home -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/"
                     Match="NavLinkMatch.All">

                <i class="fas fa-home me-2" aria-hidden="true"></i>
                Home

            </NavLink>

        </div>

        <!-- Shop -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/shop">

                <i class="fas fa-store me-2" aria-hidden="true"></i>
                Shop

            </NavLink>

        </div>

        <!-- Cart -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/cart">

                <i class="fas fa-shopping-cart me-2" aria-hidden="true"></i>
                Cart

                @if (cartItemCount > 0)
                {
                    <span class="cart-count">
                        @cartItemCount
                    </span>
                }

            </NavLink>

        </div>

        <!-- My Orders -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/my-orders">
                <i class="fas fa-box me-2" aria-hidden="true"></i> My Orders
            </NavLink>
        </div>

        <!-- Custom Tailoring -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/custom-tailoring">

                <i class="fas fa-scissors me-2" aria-hidden="true"></i>
                Custom Tailoring

            </NavLink>

        </div>

        <!-- About -->
        <div class="nav-item px-3">

            <NavLink class="nav-link"
                     href="/about">

                <i class="fas fa-info-circle me-2" aria-hidden="true"></i>
                About

            </NavLink>

        </div>
        
        <!-- My Account -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/account">
                <i class="fas fa-user me-2" aria-hidden="true"></i> My Account
            </NavLink>
        </div>

    </nav>

</div>

@code {

    /// <summary>
    /// Stores the current number of products in the shopping cart.
    /// </summary>
    private int cartItemCount;

    /// <summary>
    /// Initializes the navigation menu and subscribes to cart changes.
    /// </summary>
    protected override void OnInitialized()
    {
        cartItemCount = CartService.GetItemCount();

        CartService.CartChanged += OnCartChanged;
    }

    /// <summary>
    /// Updates the cart count when the shopping cart changes.
    /// </summary>
    private void OnCartChanged()
    {
        cartItemCount = CartService.GetItemCount();

        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Unsubscribes from the cart service when the navigation menu is disposed.
    /// </summary>
    public void Dispose()
    {
        CartService.CartChanged -= OnCartChanged;
    }
}