@page "/shop/{id:int}"
@rendermode InteractiveServer

@using DreysFashion.web.ViewModels
@using DreysFashion.web.Services.Interfaces

@inject IProductService ProductService
@inject ICartService CartService
@inject NavigationManager NavigationManager

<PageTitle>
    @(product?.Name ?? "Product") | Drey's Fashion
</PageTitle>

<div class="page-container">

    @if (loading)
    {
        <p>Loading product...</p>
    }
    else if (product == null)
    {
        <div class="product-not-found">

            <h2>Product Not Found</h2>

            <p>
                Sorry, we couldn't find the product you're looking for.
            </p>

            <a href="/shop">
                ← Back to Shop
            </a>

        </div>
    }
    else
    {
        <div class="product-details">

            <!-- Product Image -->
            <div class="product-details-image">

                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                {
                    <img src="@product.ImageUrl"
                         alt="@product.Name" />
                }
                else
                {
                    <span>
                        @product.Name
                    </span>
                }

            </div>

            <!-- Product Information -->
            <div class="product-details-info">

                <p class="eyebrow">
                    DREY'S FASHION
                </p>

                <h1>
                    @product.Name
                </h1>

                <p>
                    @product.Description
                </p>

                <h2>
                    ₦@product.Price.ToString("N0")
                </h2>

                @if (product.StockQuantity > 0 && product.IsAvailable)
                {
                    <!-- Quantity Selector -->
                    <div class="quantity-selector">

                        <label for="quantity">
                            Quantity
                        </label>

                        <div class="quantity-controls">

                            <button type="button"
                                    @onclick="DecreaseQuantity"
                                    disabled="@(quantity <= 1)">
                                −
                            </button>

                            <span>
                                @quantity
                            </span>

                            <button type="button"
                                    @onclick="IncreaseQuantity"
                                    disabled="@(quantity >= product.StockQuantity)">
                                +
                            </button>

                        </div>

                    </div>

                    <p>
                        @product.StockQuantity available
                    </p>

                    <!-- Add To Cart -->
                    <button type="button"
                            class="add-cart"
                            @onclick="AddToCart">
                        Add to Cart
                    </button>
                }
                else
                {
                    <p class="out-of-stock">
                        @(product.IsAvailable
                            ? "Out of stock"
                            : "Currently unavailable")
                    </p>

                    <button type="button"
                            class="add-cart"
                            disabled>
                        Unavailable
                    </button>
                }

                <br />

                <a href="/shop">
                    ← Back to Shop
                </a>

            </div>

        </div>
    }

</div>

@code {

    /// <summary>
    /// Gets or sets the unique identifier of the product from the route.
    /// </summary>
    [Parameter]
    public int id { get; set; }

    /// <summary>
    /// Stores the product currently being displayed.
    /// </summary>
    private ProductViewModel? product;

    /// <summary>
    /// Indicates whether the product is currently being loaded.
    /// </summary>
    private bool loading = true;

    /// <summary>
    /// Stores the quantity selected by the customer.
    /// </summary>
    private int quantity = 1;

    /// <summary>
    /// Loads the requested product when the component is initialized.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        product = await ProductService.GetProductByIdAsync(id);

        loading = false;
    }

    /// <summary>
    /// Increases the selected product quantity by one,
    /// provided the maximum available stock has not been reached.
    /// </summary>
    private void IncreaseQuantity()
    {
        if (product != null && quantity < product.StockQuantity)
        {
            quantity++;
        }
    }

    /// <summary>
    /// Decreases the selected product quantity by one,
    /// provided the quantity is greater than one.
    /// </summary>
    private void DecreaseQuantity()
    {
        if (quantity > 1)
        {
            quantity--;
        }
    }

    /// <summary>
    /// Adds the selected product and quantity to the shopping cart
    /// and navigates the customer to the cart page.
    /// </summary>
    private void AddToCart()
    {
        if (product == null || quantity <= 0)
        {
            return;
        }

        CartService.AddToCart(product, quantity);

        NavigationManager.NavigateTo("/cart");
    }
}