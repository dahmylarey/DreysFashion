@page "/order-confirmation/{id:int}"
@rendermode InteractiveServer

@using System.Security.Claims
@using DreysFashion.web.Models
@using DreysFashion.web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [Authorize]

@inject IOrderService OrderService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Order Confirmation | Drey's Fashion</PageTitle>

<div class="page-container">

    @if (loading)
    {
        <div class="page-header">

            <p class="eyebrow">
                DREY'S FASHION
            </p>

            <h1>
                Loading Your Order
            </h1>

            <p>
                Please wait while we load your order details...
            </p>

        </div>
    }
    else if (order == null)
    {
        <div class="page-header">

            <p class="eyebrow">
                DREY'S FASHION
            </p>

            <h1>
                Order Not Found
            </h1>

            <p>
                We couldn't find the order you're looking for.
            </p>

            <a href="/shop" class="add-cart">
                Continue Shopping
            </a>

        </div>
    }
    else
    {
        <div class="order-confirmation">

            <!-- Confirmation Header -->
            <div class="confirmation-header">

                <div class="confirmation-icon">
                    ✓
                </div>

                <p class="eyebrow">
                    DREY'S FASHION
                </p>

                <h1>
                    Thank You For Your Order!
                </h1>

                @if (string.Equals(
                    order.Status,
                    "Paid",
                    StringComparison.OrdinalIgnoreCase))
                {
                    <p>
                        Your payment has been successfully verified
                        and your order has been received.
                    </p>
                }
                else
                {
                    <p>
                        Your order has been received successfully.
                    </p>
                }

                <strong>
                    Order #@order.Id
                </strong>

            </div>


            <!-- Order Summary -->
            <div class="order-summary">

                <h2>
                    Order Details
                </h2>


                <!-- Customer Details -->
                <div class="order-customer-details">

                    <p>
                        <strong>Name:</strong>
                        @order.CustomerName
                    </p>

                    <p>
                        <strong>Email:</strong>
                        @order.CustomerEmail
                    </p>

                    <p>
                        <strong>Phone:</strong>
                        @order.CustomerPhone
                    </p>

                    <p>
                        <strong>Delivery Address:</strong>
                        @order.DeliveryAddress
                    </p>

                </div>


                <hr />


                <!-- Order Items -->
                <h3>
                    Items
                </h3>

                @foreach (var item in order.OrderItems)
                {
                    <div class="confirmation-item">

                        <div>

                            <strong>
                                @item.Product.Name
                            </strong>

                            <p>
                                @item.Quantity ×
                                ₦@item.UnitPrice.ToString("N0")
                            </p>

                        </div>

                        <strong>
                            ₦@item.TotalPrice.ToString("N0")
                        </strong>

                    </div>
                }


                <hr />


                <!-- Order Status -->
                <div class="summary-row">

                    <span>
                        Order Status
                    </span>

                    @if (string.Equals(
                        order.Status,
                        "Paid",
                        StringComparison.OrdinalIgnoreCase))
                    {
                        <strong class="text-success">
                            Paid
                        </strong>
                    }
                    else
                    {
                        <strong>
                            @order.Status
                        </strong>
                    }

                </div>


                <!-- Order Total -->
                <div class="summary-total">

                    <span>
                        Total
                    </span>

                    <strong>
                        ₦@order.TotalAmount.ToString("N0")
                    </strong>

                </div>

                <br />

            </div>


            <!-- Actions -->
            <div class="confirmation-actions">

                <a href="/shop" class="add-cart">
                    Continue Shopping
                </a>

            </div>

        </div>
    }

</div>

@code {

    /// <summary>
    /// Gets or sets the unique identifier of the order from the route.
    /// </summary>
    [Parameter]
    public int id { get; set; }


    /// <summary>
    /// Stores the order being displayed.
    /// </summary>
    private Order? order;


    /// <summary>
    /// Indicates whether the order is currently being loaded.
    /// </summary>
    private bool loading = true;


    /// <summary>
    /// Loads the requested order only when it belongs
    /// to the currently authenticated customer.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // =====================================================
            // GET AUTHENTICATION STATE
            // =====================================================

            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;


            // =====================================================
            // MAKE SURE USER IS AUTHENTICATED
            // =====================================================

            if (user?.Identity == null ||
                !user.Identity.IsAuthenticated)
            {
                order = null;
                return;
            }


            // =====================================================
            // GET AUTHENTICATED USER ID
            // =====================================================

            var userId =
                user.FindFirst(
                    ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(userId))
            {
                order = null;
                return;
            }


            // =====================================================
            // GET ORDER ONLY IF IT BELONGS TO THIS USER
            // =====================================================

            order =
                await OrderService.GetOrderByIdForUserAsync(
                    id,
                    userId);
        }
        catch
        {
            order = null;
        }
        finally
        {
            loading = false;
        }
    }
}