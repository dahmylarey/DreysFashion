@page "/custom-tailoring"

<PageTitle>Custom Tailoring | Drey's Fashion</PageTitle>

<div class="page-container">

    <div class="page-header">
        <p class="eyebrow">CUSTOM TAILORING</p>

        <h1>Made Specifically For You.</h1>

        <p>
            Tell us what you want and we'll help bring your design to life.
        </p>
    </div>

    <div class="tailoring-options">

        <div class="tailoring-card">
            <h3>Choose Your Style</h3>
            <p>
                Select from our existing designs or submit your own inspiration.
            </p>
        </div>

        <div class="tailoring-card">
            <h3>Your Measurements</h3>
            <p>
                Save your measurements so future orders become easier.
            </p>
        </div>

        <div class="tailoring-card">
            <h3>Track Your Order</h3>
            <p>
                Follow your outfit from cutting through sewing and finishing.
            </p>
        </div>

    </div>

</div>