```razor
@page "/shop"
@rendermode InteractiveServer

@using DreysFashion.web.ViewModels
@using DreysFashion.web.Services.Interfaces

@inject IProductService ProductService
@inject ICartService CartService
@inject NavigationManager NavigationManager

<PageTitle>Shop | Drey's Fashion</PageTitle>

<div class="page-container">

    <div class="page-header">

        <p class="eyebrow">
            DREY'S FASHION
        </p>

        <h1>
            Our Collection
        </h1>

        <p>
            Explore our collection of carefully crafted fashion pieces.
        </p>

    </div>

    @if (products == null)
    {
        <p>Loading products...</p>
    }
    else if (!products.Any())
    {
        <p>No products available at the moment.</p>
    }
    else
    {
        <div class="product-grid">

            @foreach (var product in products)
            {
                <article class="product-card">

                    <!-- Product -->
                    <div class="product-card-content"
                         @onclick="() => OpenProduct(product.Id)">

                        <!-- Product Image -->
                        <div class="product-image-container">

                            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     alt="@product.Name"
                                     class="product-shop-image" />
                            }
                            else
                            {
                                <div class="product-image-placeholder">
                                    <span>
                                        @product.Name
                                    </span>
                                </div>
                            }

                        </div>

                        <!-- Product Information -->
                        <div class="product-info">

                            <h3>
                                @product.Name
                            </h3>

                            <p>
                                @product.Description
                            </p>

                            <strong>
                                ₦@product.Price.ToString("N0")
                            </strong>

                            <br />

                            @if (product.StockQuantity > 0 && product.IsAvailable)
                            {
                                <small>
                                    @product.StockQuantity available
                                </small>
                            }
                            else
                            {
                                <small class="out-of-stock">
                                    @(product.IsAvailable
                                        ? "Out of stock"
                                        : "Currently unavailable")
                                </small>
                            }

                        </div>

                    </div>

                    <!-- Add To Cart -->
                    @if (product.StockQuantity > 0 && product.IsAvailable)
                    {
                        <button type="button"
                                class="add-cart"
                                @onclick="() => AddToCart(product)"
                                @onclick:stopPropagation="true">

                            Add to Cart

                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="add-cart"
                                disabled>

                            Unavailable

                        </button>
                    }

                </article>
            }

        </div>
    }

</div>

@code {

    /// <summary>
    /// Stores the products displayed on the shop page.
    /// </summary>
    private List<ProductViewModel>? products;

    /// <summary>
    /// Loads all available products when the Shop component is initialized.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        products = await ProductService.GetAllProductsAsync();
    }

    /// <summary>
    /// Adds the selected product to the shopping cart.
    /// </summary>
    /// <param name="product">
    /// The product selected by the customer.
    /// </param>
    private void AddToCart(ProductViewModel product)
    {
        if (product.StockQuantity <= 0 || !product.IsAvailable)
        {
            return;
        }

        CartService.AddToCart(product, 1);
    }

    /// <summary>
    /// Navigates the customer to the selected product's details page.
    /// </summary>
    /// <param name="productId">
    /// The unique identifier of the selected product.
    /// </param>
    private void OpenProduct(int productId)
    {
        NavigationManager.NavigateTo($"/shop/{productId}");
    }
}
