```razor
@page "/register"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using DreysFashion.web.Models
@using DreysFashion.web.Services.Interfaces
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject IEmailService EmailService
@inject NavigationManager NavigationManager

<PageTitle>Create Account | Drey's Fashion</PageTitle>

<div class="page-container">

    <div class="page-header">

        <p class="eyebrow">
            DREY'S FASHION
        </p>

        <h1>
            Create Your Account
        </h1>

        <p>
            Create an account to manage your orders and checkout faster.
        </p>

    </div>

    <div class="auth-container">

        <EditForm Model="model"
                  OnValidSubmit="HandleRegister">

            <DataAnnotationsValidator />

            <ValidationSummary />

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            <div class="form-group">

                <label>
                    Full Name
                </label>

                <InputText @bind-Value="model.FullName"
                           class="form-control"
                           placeholder="Enter your full name" />

                <ValidationMessage For="@(() => model.FullName)" />

            </div>

            <br />

            <div class="form-group">

                <label>
                    Email Address
                </label>

                <InputText @bind-Value="model.Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email" />

                <ValidationMessage For="@(() => model.Email)" />

            </div>

            <br />

            <div class="form-group">

                <label>
                    Password
                </label>

                <InputText @bind-Value="model.Password"
                           type="password"
                           class="form-control"
                           placeholder="Create a password" />

                <ValidationMessage For="@(() => model.Password)" />

            </div>

            <br />

            <div class="form-group">

                <label>
                    Confirm Password
                </label>

                <InputText @bind-Value="model.ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="Confirm your password" />

                <ValidationMessage For="@(() => model.ConfirmPassword)" />

            </div>

            <br />

            <button type="submit"
                    class="add-cart"
                    disabled="@registering">

                @if (registering)
                {
                    <span>Creating Account...</span>
                }
                else
                {
                    <span>Create Account</span>
                }

            </button>

            <br />

        </EditForm>

        <div class="auth-footer">

            <p>
                Already have an account?
                <a href="/login">
                    Sign in
                </a>
            </p>

        </div>

    </div>

</div>

@code {

    private RegisterModel model = new();

    private bool registering;

    private string? errorMessage;


    private async Task HandleRegister()
    {
        if (registering)
        {
            return;
        }

        registering = true;
        errorMessage = null;

        try
        {
            // =====================================================
            // CREATE USER ACCOUNT
            // =====================================================

            var user = new ApplicationUser
            {
                UserName = model.Email,
                Email = model.Email,
                FullName = model.FullName,
                CreatedAt = DateTime.UtcNow
            };

            var result =
                await UserManager.CreateAsync(
                    user,
                    model.Password);


            // =====================================================
            // CHECK REGISTRATION RESULT
            // =====================================================

            if (!result.Succeeded)
            {
                errorMessage =
                    string.Join(
                        " ",
                        result.Errors.Select(
                            error => error.Description));

                return;
            }


            // =====================================================
            // CUSTOMER WELCOME EMAIL
            // =====================================================

            try
            {
                var customerBody = $@"
<html>
<body style=""font-family:Arial,sans-serif;"">

    <h2>Welcome to Drey's Fashion, {model.FullName}!</h2>

    <p>
        Thank you for creating your account with
        <strong>Drey's Fashion</strong>.
    </p>

    <p>
        Your account has been successfully created.
    </p>

    <p>
        You can now sign in and:
    </p>

    <ul>
        <li>Browse our fashion collection</li>
        <li>Place orders</li>
        <li>Track your orders</li>
        <li>Submit custom tailoring requests</li>
        <li>Manage your measurements</li>
    </ul>

    <p>
        We look forward to serving you.
    </p>

    <p>
        <strong>Drey's Fashion</strong>
    </p>

</body>
</html>";

                await EmailService.SendAsync(
                    model.Email,
                    "Welcome to Drey's Fashion",
                    customerBody,
                    true);
            }
            catch
            {
                // Do not prevent account creation
                // if email delivery fails.
            }


            // =====================================================
            // ADMIN NOTIFICATION
            // =====================================================

            try
            {
                // CHANGE THIS TO YOUR ADMIN EMAIL ADDRESS.
                var adminEmail = "oladeleoluwada@gmail.com";

                var adminBody = $@"
<html>
<body style=""font-family:Arial,sans-serif;"">

    <h2>New Customer Registration</h2>

    <p>
        A new customer has registered on
        <strong>Drey's Fashion</strong>.
    </p>

    <hr />

    <p>
        <strong>Customer Name:</strong><br />
        {model.FullName}
    </p>

    <p>
        <strong>Email Address:</strong><br />
        {model.Email}
    </p>

    <p>
        <strong>Registration Date:</strong><br />
        {DateTime.Now:dd MMMM yyyy, hh:mm tt}
    </p>

    <hr />

    <p>
        You can now review the customer from the
        Drey's Fashion admin dashboard.
    </p>

</body>
</html>";

                await EmailService.SendAsync(
                    adminEmail,
                    $"New Customer - {model.FullName}",
                    adminBody,
                    true);
            }
            catch
            {
                // Do not prevent account creation
                // if admin notification fails.
            }


            // =====================================================
            // REDIRECT TO LOGIN
            // =====================================================

            // Do NOT sign the customer in here.
            //
            // The login page is responsible for creating
            // the authentication cookie.

            NavigationManager.NavigateTo(
                "/login?registered=true",
                forceLoad: true);

            return;
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to create your account: {ex.Message}";
        }
        finally
        {
            registering = false;
        }
    }


    // =========================================================
    // REGISTRATION MODEL
    // =========================================================

    private sealed class RegisterModel
    {
        [Required(
            ErrorMessage =
                "Please enter your full name.")]
        [StringLength(
            100,
            MinimumLength = 2,
            ErrorMessage =
                "Full name must be between 2 and 100 characters.")]
        public string FullName { get; set; } =
            string.Empty;


        [Required(
            ErrorMessage =
                "Please enter your email address.")]
        [EmailAddress(
            ErrorMessage =
                "Please enter a valid email address.")]
        public string Email { get; set; } =
            string.Empty;


        [Required(
            ErrorMessage =
                "Please enter a password.")]
        [StringLength(
            100,
            MinimumLength = 6,
            ErrorMessage =
                "Password must be at least 6 characters.")]
        public string Password { get; set; } =
            string.Empty;


        [Required(
            ErrorMessage =
                "Please confirm your password.")]
        [Compare(
            nameof(Password),
            ErrorMessage =
                "The passwords do not match.")]
        public string ConfirmPassword { get; set; } =
            string.Empty;
    }
}
```
