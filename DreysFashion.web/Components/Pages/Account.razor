@page "/account"
@rendermode InteractiveServer

@using System.Security.Claims
@using DreysFashion.web.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager

<PageTitle>My Account | Drey's Fashion</PageTitle>

<div class="page-container">

    @if (loading)
    {
        <div class="page-header">
            <p>Loading your account...</p>
        </div>
    }
    else if (!isAuthenticated)
    {
        <div class="page-header">

            <p class="eyebrow">
                DREY'S FASHION
            </p>

            <h1>
                Please Sign In
            </h1>

            <p>
                Sign in to access your account.
            </p>

            <a href="/Account/Login" class="add-cart">
                Sign In
            </a>

        </div>
    }
    else
    {
        <div class="page-header">

            <p class="eyebrow">
                DREY'S FASHION
            </p>

            <h1>
                My Account
            </h1>

            <p>
                Welcome back, @userName.
            </p>

        </div>

        <div class="account-container">

            <!-- Profile -->
            <div class="account-card">

                <div class="account-card-icon">
                    👤
                </div>

                <div class="account-card-content">

                    <h2>
                        Profile
                    </h2>

                    <p>
                        Manage your personal information.
                    </p>

                    @if (user != null)
                    {
                        <div class="account-details">

                            <div>
                                <span>
                                    Name
                                </span>

                                <strong>
                                    @user.FullName
                                </strong>
                            </div>

                            <div>
                                <span>
                                    Email
                                </span>

                                <strong>
                                    @user.Email
                                </strong>
                            </div>

                            <div>
                                <span>
                                    Phone
                                </span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                        ? "Not provided"
                                        : user.PhoneNumber)
                                </strong>
                            </div>

                        </div>
                    }

                </div>

            </div><br />


            <!-- Orders -->
            <div class="account-card">

                <div class="account-card-icon">
                    📦
                </div>

                <div class="account-card-content">

                    <h2>
                        My Orders
                    </h2>

                    <p>
                        View your orders and payment status.
                    </p>

                    <a href="/my-orders" class="add-cart">
                        View My Orders
                    </a>

                </div>

            </div><br />


            <!-- Shopping -->
            <div class="account-card">

                <div class="account-card-icon">
                    🛍
                </div>

                <div class="account-card-content">

                    <h2>
                        Continue Shopping
                    </h2>

                    <p>
                        Explore our latest fashion collection.
                    </p>

                    <a href="/shop" class="add-cart">
                        Shop Now
                    </a>

                </div>

            </div><br />


            <!-- Logout -->
            <div class="account-card logout-card">

                <div class="account-card-icon">
                    🚪
                </div>

                <div class="account-card-content">

                    <h2>
                        Sign Out
                    </h2>

                    <p>
                        Sign out of your Drey's Fashion account.
                    </p><br />

                    <button class="add-cart"
                            @onclick="LogoutAsync">
                        Sign Out
                    </button>

                </div>

            </div>

        </div>
    }

</div>

@code {

    private ApplicationUser? user;

    private bool loading = true;

    private bool isAuthenticated;

    private string userName = string.Empty;


    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var principal = authenticationState.User;

        isAuthenticated =
            principal.Identity?.IsAuthenticated ?? false;

        if (!isAuthenticated)
        {
            loading = false;
            return;
        }

        var userId =
            principal.FindFirst(
                ClaimTypes.NameIdentifier)?.Value;

        if (string.IsNullOrWhiteSpace(userId))
        {
            loading = false;
            return;
        }

        user =
            await UserManager.FindByIdAsync(userId);

        if (user != null)
        {
            userName =
                string.IsNullOrWhiteSpace(user.FullName)
                    ? user.Email ?? "Customer"
                    : user.FullName;
        }

        loading = false;
    }


    private async Task LogoutAsync()
    {
        NavigationManager.NavigateTo(
            "/account/logout",
            forceLoad: true);
    }
}