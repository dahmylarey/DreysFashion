@page "/payment-callback"
@rendermode InteractiveServer

@using System.Security.Claims
@using DreysFashion.web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject IPaymentService PaymentService
@inject IOrderService OrderService
@inject ICartService CartService
@inject IEmailService EmailService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Payment Verification | Drey's Fashion</PageTitle>

<div class="page-container">

    @if (isVerifying)
    {
        <div class="page-header">

            <p class="eyebrow">
                DREY'S FASHION
            </p>

            <h1>
                Verifying Your Payment
            </h1>

            <p>
                Please wait while we confirm your payment...
            </p>

        </div>
    }
    else if (paymentSuccessful)
    {
        <div class="page-header">

            <p class="eyebrow">
                DREY'S FASHION
            </p>

            <h1>
                Payment Successful!
            </h1>

            <p>
                Your payment has been verified successfully.
            </p>

            @if (orderId.HasValue)
            {
                <a href="/order-confirmation/@orderId"
                   class="add-cart">
                    View Your Order
                </a>
            }

        </div>
    }
    else
    {
        <div class="page-header">

            <p class="eyebrow">
                DREY'S FASHION
            </p>

            <h1>
                Payment Not Completed
            </h1>

            <p>
                We could not verify your payment.
                Your order has not been marked as paid.
            </p>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            <a href="/shop" class="add-cart">
                Return to Shop
            </a>

        </div>
    }

</div>

@code {

    /// <summary>
    /// Stores the Paystack transaction reference returned
    /// in the callback URL.
    /// </summary>
    [SupplyParameterFromQuery(Name = "reference")]
    private string? Reference { get; set; }

    /// <summary>
    /// Indicates whether payment verification is currently running.
    /// </summary>
    private bool isVerifying = true;

    /// <summary>
    /// Indicates whether the payment was successfully verified.
    /// </summary>
    private bool paymentSuccessful;

    /// <summary>
    /// Stores the identifier of the associated order.
    /// </summary>
    private int? orderId;

    /// <summary>
    /// Stores an error message when payment verification fails.
    /// </summary>
    private string? errorMessage;

    /// <summary>
    /// Verifies the Paystack transaction and marks the
    /// associated order as paid.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // =====================================================
            // VALIDATE PAYMENT REFERENCE
            // =====================================================

            if (string.IsNullOrWhiteSpace(Reference))
            {
                errorMessage =
                    "No payment reference was received from Paystack.";

                return;
            }


            // =====================================================
            // GET AUTHENTICATED USER
            // =====================================================

            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            if (user?.Identity == null ||
                !user.Identity.IsAuthenticated)
            {
                errorMessage =
                    "You must be signed in to verify this payment.";

                return;
            }

            var userId =
                user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(userId))
            {
                errorMessage =
                    "Unable to determine the authenticated customer.";

                return;
            }


            // =====================================================
            // VERIFY TRANSACTION WITH PAYSTACK
            // =====================================================

            var transaction =
                await PaymentService.VerifyPaymentAsync(Reference);

            if (transaction == null)
            {
                errorMessage =
                    "Paystack could not verify this transaction.";

                return;
            }


            // =====================================================
            // CHECK PAYMENT STATUS
            // =====================================================

            if (!string.Equals(
                    transaction.Status,
                    "success",
                    StringComparison.OrdinalIgnoreCase))
            {
                errorMessage =
                    "The payment was not successful.";

                return;
            }


            // =====================================================
            // FIND ORDER USING PAYMENT REFERENCE
            // =====================================================

            var order =
                await OrderService.GetOrderByPaymentReferenceAsync(
                    Reference);

            if (order == null)
            {
                errorMessage =
                    "The order associated with this payment could not be found.";

                return;
            }


            // =====================================================
            // SECURITY CHECK
            // =====================================================

            // Make sure the order actually belongs to
            // the authenticated customer.

            if (!string.Equals(
                    order.UserId,
                    userId,
                    StringComparison.Ordinal))
            {
                errorMessage =
                    "This payment does not belong to your account.";

                return;
            }


            // =====================================================
            // VERIFY PAYMENT AMOUNT
            // =====================================================

            var expectedAmount =
                Convert.ToInt64(order.TotalAmount * 100);

            if (transaction.Amount != expectedAmount)
            {
                errorMessage =
                    "The payment amount could not be verified.";

                return;
            }


            // =====================================================
            // VERIFY CURRENCY
            // =====================================================

            if (!string.Equals(
                    transaction.Currency,
                    "NGN",
                    StringComparison.OrdinalIgnoreCase))
            {
                errorMessage =
                    "The payment currency could not be verified.";

                return;
            }


            // =====================================================
            // MARK ORDER AS PAID
            // =====================================================

            await OrderService.MarkOrderAsPaidAsync(order.Id);


            // =====================================================
            // CLEAR CART
            // =====================================================

            // Only clear the cart after the payment has
            // successfully been verified and the order
            // has been marked as paid.

            CartService.ClearCart();


            // =====================================================
            // SEND CUSTOMER PAYMENT CONFIRMATION
            // =====================================================

            try
            {
                var customerBody = $@"
<html>
<body style=""font-family:Arial,sans-serif;"">

    <h2>Payment Successful</h2>

    <p>
        Hello <strong>{order.CustomerName}</strong>,
    </p>

    <p>
        Thank you for your order with
        <strong>Drey's Fashion</strong>.
    </p>

    <p>
        Your payment has been successfully verified.
    </p>

    <hr />

    <p>
        <strong>Order Number:</strong>
        #{order.Id}
    </p>

    <p>
        <strong>Amount Paid:</strong>
        ₦{order.TotalAmount:N0}
    </p>

    <p>
        <strong>Payment Reference:</strong>
        {order.PaymentReference}
    </p>

    <p>
        <strong>Order Status:</strong>
        Paid
    </p>

    <hr />

    <p>
        We will begin processing your order shortly.
    </p>

    <p>
        <strong>Drey's Fashion</strong>
    </p>

</body>
</html>";

                await EmailService.SendAsync(
                    order.CustomerEmail,
                    $"Payment Confirmed - Order #{order.Id}",
                    customerBody,
                    true);
            }
            catch
            {
                // Email failure must not make a successful
                // payment appear unsuccessful.
            }


            // =====================================================
            // SEND ADMIN NOTIFICATION
            // =====================================================

            try
            {
                // Change this to your actual admin email
                // if it is different.

                var adminEmail =
                    "oladeleoluwada@gmail.com";

                var adminBody = $@"
<html>
<body style=""font-family:Arial,sans-serif;"">

    <h2>New Paid Order</h2>

    <p>
        A customer has successfully completed payment
        for an order on <strong>Drey's Fashion</strong>.
    </p>

    <hr />

    <p>
        <strong>Order Number:</strong><br />
        #{order.Id}
    </p>

    <p>
        <strong>Customer:</strong><br />
        {order.CustomerName}
    </p>

    <p>
        <strong>Email:</strong><br />
        {order.CustomerEmail}
    </p>

    <p>
        <strong>Phone:</strong><br />
        {order.CustomerPhone}
    </p>

    <p>
        <strong>Delivery Address:</strong><br />
        {order.DeliveryAddress}
    </p>

    <p>
        <strong>Total Paid:</strong><br />
        ₦{order.TotalAmount:N0}
    </p>

    <p>
        <strong>Payment Reference:</strong><br />
        {order.PaymentReference}
    </p>

    <hr />

    <p>
        The order has been marked as <strong>Paid</strong>
        and stock has been updated.
    </p>

</body>
</html>";

                await EmailService.SendAsync(
                    adminEmail,
                    $"New Paid Order - #{order.Id}",
                    adminBody,
                    true);
            }
            catch
            {
                // Do not make the customer's payment appear
                // unsuccessful because an admin email failed.
            }


            // =====================================================
            // SUCCESS
            // =====================================================

            orderId = order.Id;
            paymentSuccessful = true;

            // Redirect to the order confirmation page.
            NavigationManager.NavigateTo(
                $"/order-confirmation/{order.Id}");
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Payment verification failed: {ex.Message}";
        }
        finally
        {
            isVerifying = false;
        }
    }
}