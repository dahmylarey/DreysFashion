@page "/checkout"
@rendermode InteractiveServer

@using DreysFashion.web.Services.Interfaces
@using DreysFashion.web.ViewModels
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject ICartService CartService
@inject IOrderService OrderService
@inject IPaymentService PaymentService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Checkout | Drey's Fashion</PageTitle>

<div class="page-container">

    <div class="page-header">
        <p class="eyebrow">
            DREY'S FASHION
        </p>

        <h1>
            Checkout
        </h1>

        <p>
            Enter your details to complete your order.
        </p>
    </div>

    @if (!cartItems.Any())
    {
        <div class="empty-cart">

            <h2>
                Your cart is empty
            </h2>

            <p>
                Add some products before proceeding to checkout.
            </p>

            <a href="/shop" class="add-cart">
                Continue Shopping
            </a>

        </div>
    }
    else
    {
        <div class="checkout-container">

            <!-- Checkout Form -->
            <div class="checkout-form">

                <h2>
                    Customer Information
                </h2>

                <EditForm Model="checkout"
                          OnValidSubmit="PlaceOrder">

                    <DataAnnotationsValidator />

                    <ValidationSummary />

                    <!-- Full Name -->
                    <div class="form-group">

                        <label for="customerName">
                            Full Name
                        </label>

                        <InputText id="customerName"
                                   class="form-control"
                                   @bind-Value="checkout.CustomerName" />

                        <ValidationMessage For="@(() => checkout.CustomerName)" />

                    </div>

                    <!-- Email -->
                    <div class="form-group">

                        <label for="customerEmail">
                            Email Address
                        </label>

                        <InputText id="customerEmail"
                                   type="email"
                                   class="form-control"
                                   @bind-Value="checkout.CustomerEmail" />

                        <ValidationMessage For="@(() => checkout.CustomerEmail)" />

                    </div>

                    <!-- Phone -->
                    <div class="form-group">

                        <label for="customerPhone">
                            Phone Number
                        </label>

                        <InputText id="customerPhone"
                                   class="form-control"
                                   @bind-Value="checkout.CustomerPhone" />

                        <ValidationMessage For="@(() => checkout.CustomerPhone)" />

                    </div>

                    <!-- Delivery Address -->
                    <div class="form-group">

                        <label for="deliveryAddress">
                            Delivery Address
                        </label>

                        <InputTextArea id="deliveryAddress"
                                       class="form-control"
                                       rows="4"
                                       @bind-Value="checkout.DeliveryAddress" />

                        <ValidationMessage For="@(() => checkout.DeliveryAddress)" />

                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger">
                            @errorMessage
                        </div>
                    }

                    <button type="submit"
                            class="checkout-button"
                            disabled="@isSubmitting">

                        @if (isSubmitting)
                        {
                            <span>
                                Creating Order...
                            </span>
                        }
                        else
                        {
                            <span>
                                Place Order
                            </span>
                        }

                    </button>

                </EditForm>

            </div>

            <!-- Order Summary -->
            <aside class="checkout-summary">

                <h2>
                    Order Summary
                </h2>

                @foreach (var item in cartItems)
                {
                    <div class="checkout-item">

                        <div>
                            <strong>
                                @item.ProductName
                            </strong>

                            <p>
                                @item.Quantity ×
                                ₦@item.UnitPrice.ToString("N0")
                            </p>
                        </div>

                        <strong>
                            ₦@item.TotalPrice.ToString("N0")
                        </strong>

                    </div>
                }

                <hr />

                <div class="summary-total">

                    <span>
                        Total
                    </span>

                    <strong>
                        ₦@CartService.GetTotal().ToString("N0")
                    </strong>

                </div>

            </aside>

        </div>
    }

</div>

@code {

    /// <summary>
    /// Stores the customer's checkout information.
    /// </summary>
    private CheckoutViewModel checkout = new();

    /// <summary>
    /// Stores the items currently in the shopping cart.
    /// </summary>
    private IReadOnlyList<CartItemViewModel> cartItems =
        Array.Empty<CartItemViewModel>();

    /// <summary>
    /// Indicates whether the order is currently being submitted.
    /// </summary>
    private bool isSubmitting;

    /// <summary>
    /// Stores an error message when order creation fails.
    /// </summary>
    private string? errorMessage;

    /// <summary>
    /// Loads the current shopping cart when the checkout page initializes.
    /// </summary>
    protected override void OnInitialized()
    {
        LoadCart();
    }

    /// <summary>
    /// Loads the items currently stored in the shopping cart.
    /// </summary>
    private void LoadCart()
    {
        cartItems = CartService.GetItems();
    }
    
    /// <summary>
    /// Creates a pending order for the authenticated customer,
    /// initializes the Paystack payment, and redirects the customer
    /// to Paystack to complete payment.
    /// </summary>
    private async Task PlaceOrder()
    {
        if (isSubmitting)
        {
            return;
        }

        if (!cartItems.Any())
        {
            errorMessage = "Your cart is empty.";
            return;
        }

        try
        {
            isSubmitting = true;
            errorMessage = null;

            // Get the current authentication state.
            var authState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var user = authState.User;

            // Make sure the customer is authenticated.
            if (user?.Identity == null ||
                !user.Identity.IsAuthenticated)
            {
                errorMessage =
                    "You must be signed in to place an order.";

                return;
            }

            // Get the authenticated customer's Identity ID.
            var userId =
                user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrWhiteSpace(userId))
            {
                errorMessage =
                    "Unable to determine authenticated user ID.";

                return;
            }

            // Get the authenticated customer's email.
            var authenticatedEmail =
                user.FindFirst(ClaimTypes.Email)?.Value;

            if (string.IsNullOrWhiteSpace(authenticatedEmail))
            {
                errorMessage =
                    "Unable to determine your account email.";

                return;
            }

            // Make sure the order belongs to the
            // authenticated customer's account.
            checkout.CustomerEmail = authenticatedEmail;

            // Create the order and associate it with
            // the authenticated Identity user.
            var orderId =
                await OrderService.CreateOrderAsync(
                    userId,
                    checkout,
                    cartItems);

            // Retrieve the newly created order.
            var order =
                await OrderService.GetOrderByIdAsync(orderId);

            if (order == null)
            {
                throw new InvalidOperationException(
                    $"Order {orderId} could not be found after creation.");
            }

            // Generate a unique Paystack reference.
            var paymentReference =
                $"DREYS-{orderId}-{Guid.NewGuid():N}";

            // Save the Paystack reference against the order.
            await OrderService.SetPaymentReferenceAsync(
                orderId,
                paymentReference);

            // Initialize Paystack payment.
            var payment =
                await PaymentService.InitializePaymentAsync(
                    authenticatedEmail,
                    order.TotalAmount,
                    paymentReference);

            // Redirect the customer to Paystack.
            NavigationManager.NavigateTo(
                payment.AuthorizationUrl,
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Payment initialization failed: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
   

    /// <summary>
    /// Retrieves the total amount for an order.
    /// </summary>
    /// <param name="orderId">
    /// The unique identifier of the order.
    /// </param>
    /// <returns>
    /// The total order amount.
    /// </returns>
    private async Task<decimal> GetOrderTotalAsync(int orderId)
    {
        var order = await OrderService.GetOrderByIdAsync(orderId);

        if (order == null)
        {
            throw new InvalidOperationException(
                $"Order with ID {orderId} was not found.");
        }

        return order.TotalAmount;
    }
}