@page "/"

<PageTitle>Drey's Fashion | Modern & Custom Tailoring</PageTitle>

<section class="hero">
    <div class="hero-content">
        <p class="eyebrow">DREY'S FASHION</p>

        <h1>Wear Your Style.<br />Made For You.</h1>

        <p class="hero-text">
            Discover carefully crafted fashion or create something
            unique with our custom tailoring service.
        </p>

        <div class="hero-actions">
            <a href="/shop" class="btn-primary">Shop Collection</a>
            <a href="/custom-tailoring" class="btn-secondary">Custom Tailoring</a>
        </div>
    </div>
</section>

<section class="featured-section">
    <div class="section-heading">
        <p class="eyebrow">OUR COLLECTION</p>
        <h2>Featured Designs</h2>
        <p>Explore some of our latest fashion pieces.</p>
    </div>

    <div class="product-grid">

        <article class="product-card">
            <div class="product-image">
                <span>Agbada</span>
            </div>

            <div class="product-info">
                <h3>Classic Agbada</h3>
                <p>Traditional elegance with a modern touch.</p>
                <a href="/shop">View Collection →</a>
            </div>
        </article>

        <article class="product-card">
            <div class="product-image">
                <span>Senator</span>
            </div>

            <div class="product-info">
                <h3>Senator Wear</h3>
                <p>Clean, sophisticated and professionally tailored.</p>
                <a href="/shop">View Collection →</a>
            </div>
        </article>

        <article class="product-card">
            <div class="product-image">
                <span>Native</span>
            </div>

            <div class="product-info">
                <h3>Native Collection</h3>
                <p>Contemporary styles made for every occasion.</p>
                <a href="/shop">View Collection →</a>
            </div>
        </article>

    </div>
</section>