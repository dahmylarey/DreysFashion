@page "/admin"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using DreysFashion.web.Services.Interfaces
@using DreysFashion.web.Models

@attribute [Authorize(Roles = "Admin")]

@inject IProductService ProductService
@inject IOrderService OrderService
@inject ITailoringService TailoringService

<PageTitle>Admin Dashboard | Drey's Fashion</PageTitle>

<div class="page-container">

    <!-- =========================
         DASHBOARD HEADER
         ========================= -->

    <div class="page-header d-flex flex-column flex-md-row align-items-start justify-content-between gap-3">

        <div>

            <p class="eyebrow text-muted">
                DREY'S FASHION
            </p>

            <h1 class="h3 mb-1">
                Admin Dashboard
            </h1>

            <p class="text-muted mb-0">
                Manage your fashion store.
            </p>

        </div>

        <div class="admin-toolbar d-flex gap-2 flex-wrap">

            <a href="/admin/products"
               class="btn btn-primary btn-sm">

                <i class="fas fa-box-open me-2"></i>
                Manage Products

            </a>

            <a href="/admin/orders"
               class="btn btn-outline-secondary btn-sm">

                <i class="fas fa-receipt me-2"></i>
                Manage Orders

            </a>

            <a href="/admin/customers"
               class="btn btn-outline-secondary btn-sm">

                <i class="fas fa-users me-2"></i>
                View Customers

            </a>

            <a href="/admin/tailoring"
               class="btn btn-outline-secondary btn-sm">

                <i class="fas fa-cut me-2"></i>
                Manage Tailoring

            </a>

        </div>

    </div>


    <!-- =========================
         MAIN ADMIN MENU
         ========================= -->

    <div class="admin-dashboard mt-4">

        <div class="row g-3">


            <!-- PRODUCTS -->

            <div class="col-12 col-md-6 col-xl-3">

                <div class="card h-100">

                    <div class="card-body d-flex gap-3 align-items-start">

                        <div class="display-6 text-primary">

                            <i class="fas fa-box-open"></i>

                        </div>

                        <div>

                            <h5 class="card-title mb-1">
                                Products
                            </h5>

                            <p class="card-text text-muted small">
                                Add, edit and manage your products.
                            </p>

                            <a href="/admin/products"
                               class="stretched-link">
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ORDERS -->

            <div class="col-12 col-md-6 col-xl-3">

                <div class="card h-100">

                    <div class="card-body d-flex gap-3 align-items-start">

                        <div class="display-6 text-success">

                            <i class="fas fa-receipt"></i>

                        </div>

                        <div>

                            <h5 class="card-title mb-1">
                                Orders
                            </h5>

                            <p class="card-text text-muted small">
                                View and manage customer orders.
                            </p>

                            <a href="/admin/orders"
                               class="stretched-link">
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- CUSTOMERS -->

            <div class="col-12 col-md-6 col-xl-3">

                <div class="card h-100">

                    <div class="card-body d-flex gap-3 align-items-start">

                        <div class="display-6 text-warning">

                            <i class="fas fa-users"></i>

                        </div>

                        <div>

                            <h5 class="card-title mb-1">
                                Customers
                            </h5>

                            <p class="card-text text-muted small">
                                View registered customers.
                            </p>

                            <a href="/admin/customers"
                               class="stretched-link">
                            </a>

                        </div>

                    </div>

                </div>

            </div>


            <!-- CUSTOM TAILORING -->

            <div class="col-12 col-md-6 col-xl-3">

                <div class="card h-100">

                    <div class="card-body d-flex gap-3 align-items-start">

                        <div class="display-6 text-danger">

                            <i class="fas fa-cut"></i>

                        </div>

                        <div>

                            <h5 class="card-title mb-1">
                                Custom Tailoring
                            </h5>

                            <p class="card-text text-muted small">
                                Manage customer tailoring requests,
                                quotations and progress.
                            </p>

                            <a href="/admin/tailoring"
                               class="stretched-link">
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         STATISTICS
         ========================= -->
    @if (loading)
    {
        <div class="mt-4">

            <div class="alert alert-light">
                Loading store statistics...
            </div>

        </div>
    }
    else
    {

        <div class="row g-3 mt-4">


            <!-- TOTAL PRODUCTS -->

            <div class="col-12 col-sm-6 col-xl-3">

                <div class="card h-100">

                    <div class="card-body">

                        <div class="text-primary fs-2">

                            <i class="fas fa-box-open"></i>

                        </div>

                        <p class="text-muted mb-1">
                            Total Products
                        </p>

                        <h2>
                            @totalProducts
                        </h2>

                        <a href="/admin/products"
                           class="small text-decoration-none">

                            Manage Products →

                        </a>

                    </div>

                </div>

            </div>


            <!-- TOTAL ORDERS -->

            <div class="col-12 col-sm-6 col-xl-3">

                <div class="card h-100">

                    <div class="card-body">

                        <div class="text-success fs-2">

                            <i class="fas fa-receipt"></i>

                        </div>

                        <p class="text-muted mb-1">
                            Total Orders
                        </p>

                        <h2>
                            @totalOrders
                        </h2>

                        <a href="/admin/orders"
                           class="small text-decoration-none">

                            Manage Orders →

                        </a>

                    </div>

                </div>

            </div>


            <!-- PAID ORDERS -->

            <div class="col-12 col-sm-6 col-xl-3">

                <div class="card h-100">

                    <div class="card-body">

                        <div class="text-success fs-2">

                            <i class="fas fa-check-circle"></i>

                        </div>

                        <p class="text-muted mb-1">
                            Paid Orders
                        </p>

                        <h2>
                            @paidOrders
                        </h2>

                    </div>

                </div>

            </div>


            <!-- PENDING ORDERS -->

            <div class="col-12 col-sm-6 col-xl-3">

                <div class="card h-100">

                    <div class="card-body">

                        <div class="text-warning fs-2">

                            <i class="fas fa-clock"></i>

                        </div>

                        <p class="text-muted mb-1">
                            Pending Orders
                        </p>

                        <h2>
                            @pendingOrders
                        </h2>

                    </div>

                </div>

            </div>


            <!-- TOTAL TAILORING REQUESTS -->

            <div class="col-12 col-sm-6 col-xl-3">

                <div class="card h-100">

                    <div class="card-body">

                        <div class="text-danger fs-2">

                            <i class="fas fa-cut"></i>

                        </div>

                        <p class="text-muted mb-1">
                            Tailoring Requests
                        </p>

                        <h2>
                            @totalTailoringRequests
                        </h2>

                        <a href="/admin/tailoring"
                           class="small text-decoration-none">

                            Manage Tailoring →

                        </a>

                    </div>

                </div>

            </div>


            <!-- PENDING TAILORING -->

            <div class="col-12 col-sm-6 col-xl-3">

                <div class="card h-100">

                    <div class="card-body">

                        <div class="text-warning fs-2">

                            <i class="fas fa-hourglass-half"></i>

                        </div>

                        <p class="text-muted mb-1">
                            Pending Tailoring
                        </p>

                        <h2>
                            @pendingTailoringRequests
                        </h2>

                        <a href="/admin/tailoring"
                           class="small text-decoration-none">

                            View Requests →

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================
             REVENUE + RECENT ORDERS
             ========================= -->

        <div class="row g-3 mt-1">


            <!-- REVENUE -->

            <div class="col-12 col-md-6">

                <div class="card">

                    <div class="card-body">

                        <p class="text-muted mb-1">
                            Total Revenue
                        </p>

                        <h2>
                            ₦@totalRevenue.ToString("N0")
                        </h2>

                        <small class="text-muted">
                            From paid orders
                        </small>

                    </div>

                </div>

            </div>


            <!-- RECENT ORDERS COUNT -->

            <div class="col-12 col-md-6">

                <div class="card">

                    <div class="card-body">

                        <p class="text-muted mb-1">
                            Recent Orders
                        </p>

                        <h2>
                            @recentOrders.Count
                        </h2>

                        <a href="/admin/orders"
                           class="small text-decoration-none">

                            View Orders →

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- =========================
             RECENT ORDERS
             ========================= -->

        <div class="mt-5">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h2 class="h4 mb-0">
                    Recent Orders
                </h2>

                <a href="/admin/orders"
                   class="text-decoration-none">

                    View All →

                </a>

            </div>


            @if (!recentOrders.Any())
            {
                <div class="alert alert-light">

                    No orders yet.

                </div>
            }
            else
            {

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Order
                                </th>

                                <th>
                                    Customer
                                </th>

                                <th>
                                    Amount
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var order in recentOrders)
                            {

                                <tr>

                                    <td>
                                        #@order.Id
                                    </td>

                                    <td>
                                        @order.CustomerName
                                    </td>

                                    <td>
                                        ₦@order.TotalAmount.ToString("N0")
                                    </td>

                                    <td>

                                        @if (order.Status == "Paid")
                                        {
                                            <span class="badge bg-success">
                                                Paid
                                            </span>
                                        }
                                        else if (order.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @order.Status
                                            </span>
                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>


        <!-- =========================
             RECENT CUSTOM TAILORING
             ========================= -->

        <div class="mt-5">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h2 class="h4 mb-0">
                    Recent Custom Tailoring Requests
                </h2>

                <a href="/admin/tailoring"
                   class="text-decoration-none">

                    View All →

                </a>

            </div>


            @if (!recentTailoringRequests.Any())
            {
                <div class="alert alert-light">

                    No custom tailoring requests yet.

                </div>
            }
            else
            {

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Request
                                </th>

                                <th>
                                    Customer
                                </th>

                                <th>
                                    Outfit
                                </th>

                                <th>
                                    Quote
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var request in recentTailoringRequests)
                            {

                                <tr>

                                    <td>
                                        #@request.Id
                                    </td>

                                    <td>
                                        @(request.User?.FullName ?? "Unknown Customer")
                                    </td>

                                    <td>
                                        @request.OutfitType
                                    </td>

                                    <td>

                                        @if (request.QuotedAmount.HasValue)
                                        {
                                            <span>
                                                ₦@request.QuotedAmount.Value.ToString("N0")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Awaiting quote
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (request.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (request.Status == "Quote Provided")
                                        {
                                            <span class="badge bg-info text-dark">
                                                Quote Provided
                                            </span>
                                        }
                                        else if (request.Status == "In Progress")
                                        {
                                            <span class="badge bg-primary">
                                                In Progress
                                            </span>
                                        }
                                        else if (request.Status == "Ready")
                                        {
                                            <span class="badge bg-success">
                                                Ready
                                            </span>
                                        }
                                        else if (request.Status == "Completed")
                                        {
                                            <span class="badge bg-success">
                                                Completed
                                            </span>
                                        }
                                        else if (request.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @request.Status
                                            </span>
                                        }

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    }

</div>


@code {

    // =========================
    // Dashboard state
    // =========================

    private bool loading = true;

    private int totalProducts;

    private int totalOrders;

    private int paidOrders;

    private int pendingOrders;

    private decimal totalRevenue;

    private int totalTailoringRequests;

    private int pendingTailoringRequests;

    private List<Order> recentOrders = new();

    private List<TailoringRequest> recentTailoringRequests = new();


    // =========================
    // Load dashboard
    // =========================

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // =========================
            // PRODUCTS
            // =========================

            var products =
                await ProductService.GetAllProductsAsync();

            totalProducts =
                products.Count;


            // =========================
            // ORDERS
            // =========================

            var orders =
                await OrderService.GetAllOrdersAsync();

            totalOrders =
                orders.Count;


            // =========================
            // PAID ORDERS
            // =========================

            paidOrders =
                orders.Count(order =>
                    order.Status == "Paid" ||
                    order.Status == "Processing" ||
                    order.Status == "Shipped" ||
                    order.Status == "Delivered");


            // =========================
            // PENDING ORDERS
            // =========================

            pendingOrders =
                orders.Count(order =>
                    order.Status == "Pending");


            // =========================
            // REVENUE
            // =========================

            totalRevenue =
                orders
                    .Where(order =>
                        order.Status == "Paid" ||
                        order.Status == "Processing" ||
                        order.Status == "Shipped" ||
                        order.Status == "Delivered")
                    .Sum(order =>
                        order.TotalAmount);


            // =========================
            // RECENT ORDERS
            // =========================

            recentOrders =
                orders
                    .OrderByDescending(order =>
                        order.CreatedAt)
                    .Take(5)
                    .ToList();


            // =========================
            // TAILORING REQUESTS
            // =========================

            var tailoringRequests =
                await TailoringService.GetAllRequestsAsync();

            totalTailoringRequests =
                tailoringRequests.Count;


            // =========================
            // PENDING TAILORING
            // =========================

            pendingTailoringRequests =
                tailoringRequests.Count(request =>
                    request.Status == "Pending");


            // =========================
            // RECENT TAILORING REQUESTS
            // =========================

            recentTailoringRequests =
                tailoringRequests
                    .OrderByDescending(request =>
                        request.CreatedAt)
                    .Take(5)
                    .ToList();
        }
        finally
        {
            loading = false;
        }
    }
}