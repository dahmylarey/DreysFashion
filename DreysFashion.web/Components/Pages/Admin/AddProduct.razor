@page "/admin/products/add"
@rendermode InteractiveServer

@using DreysFashion.web.ViewModels
@using DreysFashion.web.Services.Interfaces
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@attribute [Authorize(Roles = "Admin")]

@inject IProductService ProductService
@inject NavigationManager NavigationManager

<PageTitle>Add Product | Drey's Fashion</PageTitle>

<div class="page-container">

    <div class="page-header">

        <p class="eyebrow">
            DREY'S FASHION
        </p>

        <h1>
            Add Product
        </h1>

        <p>
            Add a new product to your fashion store.
        </p>

    </div>

    <div class="row checkout-container g-4">

        <!-- FORM -->
        <div class="col-12 col-md-7">

            <div class="card">

                <div class="card-body">

                    <EditForm Model="product"
                              OnValidSubmit="SaveProduct">

                        <DataAnnotationsValidator />

                        <ValidationSummary />

                        <!-- Product Name -->
                        <div class="form-group mb-3">

                            <label for="name">
                                Product Name
                            </label>

                            <InputText id="name"
                                       class="form-control"
                                       @bind-Value="product.Name" />

                            <ValidationMessage For="@(() => product.Name)" />

                        </div>

                        <!-- Description -->
                        <div class="form-group mb-3">

                            <label for="description">
                                Description
                            </label>

                            <InputTextArea id="description"
                                           class="form-control"
                                           rows="5"
                                           @bind-Value="product.Description" />

                            <ValidationMessage For="@(() => product.Description)" />

                        </div>

                        <!-- Price -->
                        <div class="form-group mb-3">

                            <label for="price">
                                Price (₦)
                            </label>

                            <InputNumber id="price"
                                         class="form-control"
                                         @bind-Value="product.Price" />

                            <ValidationMessage For="@(() => product.Price)" />

                        </div>

                        <!-- Stock -->
                        <div class="form-group mb-3">

                            <label for="stock">
                                Stock Quantity
                            </label>

                            <InputNumber id="stock"
                                         class="form-control"
                                         @bind-Value="product.StockQuantity" />

                            <ValidationMessage For="@(() => product.StockQuantity)" />

                        </div>

                        <!-- PRODUCT IMAGE -->
                        <div class="form-group mb-3">

                            <label for="productImage"
                                   class="form-label">

                                Product Image

                            </label>

                            <InputFile id="productImage"
                                       OnChange="HandleImageSelected"
                                       accept=".jpg,.jpeg,.png,.webp"
                                       class="form-control" />

                            <small class="text-muted">

                                JPG, JPEG, PNG or WEBP.
                                Maximum size: 5 MB.

                            </small>

                            @if (selectedImage != null)
                            {
                                <div class="mt-2">

                                    <span class="badge bg-success">

                                        <i class="fas fa-check me-1"></i>

                                        @selectedImage.Name

                                    </span>

                                </div>
                            }

                        </div>

                        <!-- Availability -->
                        <div class="form-group mb-3">

                            <div class="form-check">

                                <InputCheckbox id="available"
                                               class="form-check-input"
                                               @bind-Value="product.IsAvailable" />

                                <label class="form-check-label"
                                       for="available">

                                    Product is available for purchase

                                </label>

                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger">

                                @errorMessage

                            </div>
                        }

                        <div class="admin-actions d-flex gap-2">

                            <button type="submit"
                                    class="add-cart"
                                    disabled="@isSaving">

                                @if (isSaving)
                                {
                                    <span>
                                        Saving Product...
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Save Product
                                    </span>
                                }

                            </button>

                            <a href="/admin/products"
                               class="secondary-button">

                                Cancel

                            </a>

                        </div>

                    </EditForm>

                </div>

            </div>

        </div>

        <!-- PREVIEW -->
        <aside class="col-12 col-md-5">

            <div class="card">

                <div class="card-body">

                    <h5 class="card-title">
                        Product Preview
                    </h5>

                    @if (!string.IsNullOrWhiteSpace(previewImageUrl))
                    {
                        <img src="@previewImageUrl"
                             alt="@product.Name"
                             class="img-fluid rounded mb-3"
                             style="max-height:300px; width:100%; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex flex-column align-items-center justify-content-center mb-3"
                             style="height:300px;">

                            <i class="fas fa-image fa-3x text-muted mb-2"></i>

                            <span class="text-muted">
                                Product image preview
                            </span>

                        </div>
                    }

                    <h6 class="mb-1">

                        @(string.IsNullOrWhiteSpace(product.Name)
                            ? "Product Name"
                            : product.Name)

                    </h6>

                    <p class="text-muted small mb-2">

                        @(string.IsNullOrWhiteSpace(product.Description)
                            ? "Product description"
                            : product.Description)

                    </p>

                    <div class="d-flex align-items-center justify-content-between">

                        <strong>
                            ₦@product.Price.ToString("N0")
                        </strong>

                        <span class="text-muted small">

                            Stock:
                            @product.StockQuantity

                        </span>

                    </div>

                </div>

            </div>

        </aside>

    </div>

</div>

@code {

    private ProductViewModel product = new()
    {
        IsAvailable = true
    };

    private IBrowserFile? selectedImage;

    private string? previewImageUrl;

    private bool isSaving;

    private string? errorMessage;

    private async Task HandleImageSelected(
        InputFileChangeEventArgs e)
    {
        errorMessage = null;

        selectedImage = e.File;

        if (selectedImage == null)
        {
            previewImageUrl = null;

            return;
        }

        if (selectedImage.Size > 5 * 1024 * 1024)
        {
            errorMessage =
                "Product image cannot be larger than 5 MB.";

            selectedImage = null;
            previewImageUrl = null;

            return;
        }

        var extension =
            Path.GetExtension(selectedImage.Name)
                .ToLowerInvariant();

        if (extension != ".jpg" &&
            extension != ".jpeg" &&
            extension != ".png" &&
            extension != ".webp")
        {
            errorMessage =
                "Only JPG, JPEG, PNG and WEBP images are allowed.";

            selectedImage = null;
            previewImageUrl = null;

            return;
        }

        try
        {
            await using var stream =
                selectedImage.OpenReadStream(
                    5 * 1024 * 1024);

            using var memoryStream =
                new MemoryStream();

            await stream.CopyToAsync(memoryStream);

            var imageBytes =
                memoryStream.ToArray();

            previewImageUrl =
                $"data:{selectedImage.ContentType};base64,{Convert.ToBase64String(imageBytes)}";
        }
        catch
        {
            selectedImage = null;
            previewImageUrl = null;

            errorMessage =
                "Unable to preview the selected image.";
        }
    }

    private async Task SaveProduct()
    {
        if (isSaving)
        {
            return;
        }

        try
        {
            isSaving = true;

            errorMessage = null;

            await ProductService.CreateProductAsync(
                product,
                selectedImage);

            NavigationManager.NavigateTo(
                "/admin/products",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to save product: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}